#!/usr/bin/env bash
set -euo pipefail
branch=$(git symbolic-ref --short HEAD 2>/dev/null || echo "")
if [ "$branch" = "main" ]; then
	echo "pre-commit: direct commits to main are blocked. Use a feature branch (feat/..., fix/...)." >&2
	exit 1
fi
if git diff --cached --name-only --diff-filter=ACM | grep -q '\.odin$'; then
	./build.sh fmt-check
	./build.sh check
fi
