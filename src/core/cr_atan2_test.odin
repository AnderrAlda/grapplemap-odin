package core

import "core:strconv"
import "core:strings"
import "core:testing"

// cr_atan2 is checked bit for bit against a correctly rounded reference (ADR 0003, amendment #161).
// The finite cases come from tests/fixtures/cr_atan2.txt, generated by tools/cr_atan2_ref.py (Python `decimal` at
// 200 digits or more, rounded once to binary64); see the fixture header for the exact commands. Special values
// (zeros, infinities, NaN) are written here by hand from C99 Annex F.9.1.4, with π, π/2, π/4 and 3π/4 rounded to
// nearest.

@(private = "file")
PI_BITS :: 0x400921fb54442d18
@(private = "file")
PI_2_BITS :: 0x3ff921fb54442d18
@(private = "file")
PI_4_BITS :: 0x3fe921fb54442d18
@(private = "file")
PI_3_4_BITS :: 0x4002d97c7f3321d2
@(private = "file")
NEG :: 0x8000000000000000
@(private = "file")
POS_INF :: 0x7ff0000000000000
@(private = "file")
NEG_INF :: 0xfff0000000000000
@(private = "file")
POS_ZERO :: 0x0000000000000000
@(private = "file")
NEG_ZERO :: 0x8000000000000000
@(private = "file")
ONE :: 0x3ff0000000000000
@(private = "file")
MIN_SUBNORMAL :: 0x0000000000000001
@(private = "file")
MAX_FINITE :: 0x7fefffffffffffff

@(private = "file")
FIXTURE :: #load("../../tests/fixtures/cr_atan2.txt", string)

@(private = "file")
Case :: struct {
	y, x, want: u64,
}

@(private = "file")
from_bits :: proc(u: u64) -> f64 {
	return transmute(f64)u
}

@(private = "file")
got_bits :: proc(c: Case) -> u64 {
	return transmute(u64)cr_atan2(from_bits(c.y), from_bits(c.x))
}

@(private = "file")
check_cases :: proc(t: ^testing.T, cases: []Case) {
	for c in cases {
		got := got_bits(c)
		testing.expectf(
			t,
			got == c.want,
			"cr_atan2(%16x, %16x) = %16x, want %16x",
			c.y,
			c.x,
			got,
			c.want,
		)
	}
}

// fixture_cases parses the fixture lines "y x atan2" (16-digit hex bits) of section `name` (`# section <name>`).
@(private = "file")
fixture_cases :: proc(t: ^testing.T, name: string, allocator := context.temp_allocator) -> []Case {
	cases := make([dynamic]Case, allocator)
	in_section := false
	s: string = FIXTURE
	for line in strings.split_lines_iterator(&s) {
		if strings.has_prefix(line, "# section ") {
			in_section = strings.trim_space(line[len("# section "):]) == name
			continue
		}
		if !in_section || line == "" || line[0] == '#' {
			continue
		}
		f := line
		vals: [3]u64
		n := 0
		for field in strings.fields_iterator(&f) {
			if n == 3 {
				n += 1
				break
			}
			v, ok := strconv.parse_u64_of_base(field, 16)
			testing.expectf(t, ok, "bad fixture field %q in %q", field, line)
			vals[n] = v
			n += 1
		}
		testing.expectf(t, n == 3, "bad fixture line %q", line)
		append(&cases, Case{vals[0], vals[1], vals[2]})
	}
	return cases[:]
}

@(test)
test_cr_atan2_zeros :: proc(t: ^testing.T) {
	check_cases(
		t,
		{
			{POS_ZERO, POS_ZERO, POS_ZERO},
			{NEG_ZERO, POS_ZERO, NEG_ZERO},
			{POS_ZERO, NEG_ZERO, PI_BITS},
			{NEG_ZERO, NEG_ZERO, PI_BITS | NEG},
			{POS_ZERO, ONE, POS_ZERO},
			{NEG_ZERO, ONE, NEG_ZERO},
			{POS_ZERO, MIN_SUBNORMAL, POS_ZERO},
			{NEG_ZERO, MAX_FINITE, NEG_ZERO},
			{POS_ZERO, ONE | NEG, PI_BITS},
			{NEG_ZERO, ONE | NEG, PI_BITS | NEG},
			{POS_ZERO, MIN_SUBNORMAL | NEG, PI_BITS},
			{ONE, POS_ZERO, PI_2_BITS},
			{ONE, NEG_ZERO, PI_2_BITS},
			{ONE | NEG, POS_ZERO, PI_2_BITS | NEG},
			{ONE | NEG, NEG_ZERO, PI_2_BITS | NEG},
			{MIN_SUBNORMAL, NEG_ZERO, PI_2_BITS},
			{MAX_FINITE | NEG, POS_ZERO, PI_2_BITS | NEG},
		},
	)
}

@(test)
test_cr_atan2_infinities :: proc(t: ^testing.T) {
	check_cases(
		t,
		{
			{POS_INF, POS_INF, PI_4_BITS},
			{NEG_INF, POS_INF, PI_4_BITS | NEG},
			{POS_INF, NEG_INF, PI_3_4_BITS},
			{NEG_INF, NEG_INF, PI_3_4_BITS | NEG},
			{POS_INF, ONE, PI_2_BITS},
			{POS_INF, ONE | NEG, PI_2_BITS},
			{NEG_INF, POS_ZERO, PI_2_BITS | NEG},
			{NEG_INF, MAX_FINITE | NEG, PI_2_BITS | NEG},
			{ONE, POS_INF, POS_ZERO},
			{ONE | NEG, POS_INF, NEG_ZERO},
			{POS_ZERO, POS_INF, POS_ZERO},
			{NEG_ZERO, POS_INF, NEG_ZERO},
			{ONE, NEG_INF, PI_BITS},
			{ONE | NEG, NEG_INF, PI_BITS | NEG},
			{POS_ZERO, NEG_INF, PI_BITS},
			{NEG_ZERO, NEG_INF, PI_BITS | NEG},
			{MAX_FINITE, NEG_INF, PI_BITS},
		},
	)
}

@(test)
test_cr_atan2_nan_propagates :: proc(t: ^testing.T) {
	nans := [?]u64{0x7ff8000000000000, 0xfff8000000000000, 0x7ff0000000000001}
	others := [?]u64 {
		POS_ZERO,
		NEG_ZERO,
		ONE,
		ONE | NEG,
		POS_INF,
		NEG_INF,
		MIN_SUBNORMAL,
		0x7ff8000000000000,
	}
	for n in nans {
		for o in others {
			a := cr_atan2(from_bits(n), from_bits(o))
			b := cr_atan2(from_bits(o), from_bits(n))
			testing.expectf(t, a != a, "cr_atan2(%16x, %16x) = %v, want NaN", n, o, a)
			testing.expectf(t, b != b, "cr_atan2(%16x, %16x) = %v, want NaN", o, n, b)
		}
	}
}

// Quadrants and signs (C99 Annex F: atan2(-y, x) = -atan2(y, x); x < 0 gives |result| > π/2).
@(test)
test_cr_atan2_quadrants_and_odd_symmetry :: proc(t: ^testing.T) {
	for c in fixture_cases(t, "random") {
		y, x := from_bits(c.y), from_bits(c.x)
		r := cr_atan2(y, x)
		// Sign bits, not `r < 0`: a result that underflows to -0 is negative too.
		testing.expectf(
			t,
			transmute(u64)r >> 63 == c.y >> 63,
			"sign of cr_atan2(%16x, %16x) = %v",
			c.y,
			c.x,
			r,
		)
		if x < 0 {
			testing.expectf(
				t,
				abs(r) >= from_bits(PI_2_BITS),
				"quadrant of cr_atan2(%16x, %16x) = %v",
				c.y,
				c.x,
				r,
			)
		} else {
			testing.expectf(
				t,
				abs(r) <= from_bits(PI_2_BITS),
				"quadrant of cr_atan2(%16x, %16x) = %v",
				c.y,
				c.x,
				r,
			)
		}
		testing.expectf(
			t,
			transmute(u64)cr_atan2(-y, x) == transmute(u64)r ~ NEG,
			"cr_atan2(-y, x) != -cr_atan2(y, x) for %16x, %16x",
			c.y,
			c.x,
		)
	}
}

// Subnormal inputs, y/x overflow and underflow, the tiny-y/x shortcuts and the octant boundaries.
@(test)
test_cr_atan2_edge_finite :: proc(t: ^testing.T) {
	cases := fixture_cases(t, "edge")
	testing.expect(t, len(cases) >= 20)
	check_cases(t, cases)
}

// The two angles measured in #161 (blocks 654 pos 1 and 608 pos 2 of the DB): `heading` of those positions.
// Odin's math.atan2 is 1 ULP off on the first, glibc 2.39's on the second; the oracle gives the correctly rounded
// value on both (the oracle's `normalRotation` is the negation, 0x3fb049950bb58de0 on the first).
@(test)
test_cr_atan2_issue_161_angles :: proc(t: ^testing.T) {
	check_cases(
		t,
		{
			{0xbfacac083126e980, 0x3fec20c49ba5e354, 0xbfb049950bb58de0},
			{0x3fcd70a3d70a3d70, 0x3fea872b020c49ba, 0x3fd152189c2a5209},
		},
	)
}

// CORE-MATH's hard cases for atan2 (src/binary64/atan2/atan2.wc): pairs whose result is very close to a rounding
// boundary, which exercise the accurate (192-bit) path.
@(test)
test_cr_atan2_worst_cases :: proc(t: ^testing.T) {
	cases := fixture_cases(t, "worst")
	testing.expect(t, len(cases) >= 20)
	check_cases(t, cases)
}

@(test)
test_cr_atan2_random :: proc(t: ^testing.T) {
	cases := fixture_cases(t, "random")
	testing.expect(t, len(cases) >= 1000)
	check_cases(t, cases)
}
